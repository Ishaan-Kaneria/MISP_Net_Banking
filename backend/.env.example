DATABASE_URL=sqlite:///./arthai.db
JWT_SECRET=replace-with-a-random-32-byte-secret
JWT_EXPIRE_MIN=720
CORS_ORIGINS=http://localhost:3000
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
# Add Money (Razorpay). Leave both blank to keep the feature disabled —
# /wallet/topup/order returns 503 and the frontend hides the Add Money
# button, same graceful-degradation pattern as GEMINI_API_KEY above.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WALLET_TOPUP_MAX_AMOUNT=100000
